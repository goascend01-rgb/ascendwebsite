# ==============================================================
# Form delivery. Set ONE of the two adapters, or both.
#
# Until one is set, the contact and application forms return an
# error and tell the visitor nothing was sent. That is deliberate:
# a form that reports success while dropping the submission is the
# exact failure this site argues against.
# ==============================================================

# --- Adapter 1: email via Resend -----------------------------
# Sign up at resend.com, verify the goascend.co domain, create a key.
# Resend is a subprocessor and is listed as one on /legal/privacy.
RESEND_API_KEY=
# Where submissions land. Comma separated for more than one.
FORM_TO_EMAIL=hello@goascend.co
# Must be on a domain verified in Resend.
FORM_FROM_EMAIL=website@goascend.co

# --- Adapter 2: webhook --------------------------------------
# Any endpoint that accepts a JSON POST: Zapier, Make, n8n, Slack,
# a CRM. If this points at a third party that stores submissions,
# add that party to the subprocessor table in src/lib/site.ts and
# to /legal/privacy section 7.
FORM_WEBHOOK_URL=
# Optional. Sent as: Authorization: Bearer <token>
FORM_WEBHOOK_TOKEN=
